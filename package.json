{
  "name": "@limulus/eslint-config",
  "version": "3.1.0",
  "description": "A shared ESLint configuration",
  "main": "index.js",
  "repository": "https://github.com/limulus/eslint-config.git",
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://www.limulus.net/"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./prettier": {
      "import": "./prettier.js"
    }
  },
  "bin": {
    "limulus-format": "./dist/bin/cli.js"
  },
  "files": [
    "index.js",
    "prettier.js",
    "dist",
    "src",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --outDir dist",
    "clean": "del-cli *.tsbuildinfo coverage dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "prepare": "husky",
    "test": "vitest run --coverage",
    "test:pack": "vitest run -c vitest.pack.config.ts",
    "tscc": "tsc --noEmit",
    "verify": "npm run format:check && npm run test && npm run tscc"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-config-universe": "^16.0.0",
    "globals": "^17.9.0"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "eslint_d": ">=15",
    "prettier": ">=3",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "eslint_d": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "del-cli": "^6.0.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "prettier": "^3.5.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
